# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Real environment variables take precedence over this file.

# Angel One SmartAPI credentials (used by angelone_autologin.py)
ANGEL_CLIENT_CODE=A1234567
ANGEL_PIN=0000
ANGEL_TOTP_SECRET=REPLACE_WITH_BASE32_TOTP_SEED
ANGEL_API_KEY=replace-me

# Ingestion: "embedded" (provider inside the API process, no Redis) or "redis"
# (run `python -m backend.app.workers.ingest` alongside the API)
INGEST_MODE=embedded
REDIS_URL=redis://127.0.0.1:56379/0
# Archive every normalized tick under data/ticks/ (1 = on, 0 = off)
RECORD_RAW_TICKS=1

# PostgreSQL + TimescaleDB (docker-compose.dev.yml: port 55432). Leave unset to run
# without a database (JSONL files only).
DATABASE_URL=postgresql+asyncpg://ofmp:ofmp_dev_password@127.0.0.1:55432/ofmp
# Rebuild today's live footprint from stored trades on startup (1 = on)
RESTORE_SESSION_ON_START=1

# Optional: pin a far-month contract instead of auto-rolling to the front month
# INSTRUMENT_EXPIRY_MONTH=DEC
